# Railway Environment Variables for Backend
# Copy these into Railway > Your Project > Variables

# Supabase / PostgreSQL Database Connection (JDBC format required for Spring Boot)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.fpbxuarfttscxzwstdrj
SPRING_DATASOURCE_PASSWORD=your_database_password_here

# Supabase Credentials
SUPABASE_URL=https://fpbxuarfttscxzwstdrj.supabase.co
SUPABASE_KEY=your_supabase_secret_key
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Optional: CORS allowed origins (defaults to open if not specified)
# Example: https://your-frontend.vercel.app
APP_CORS_ALLOWED_ORIGINS=https://*.vercel.app,http://localhost:5173
